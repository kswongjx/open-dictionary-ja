# Open Japanese Dictionary - Environment Configuration
# Copy this file to .env and update the values

# PostgreSQL Database Connection
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://user:password@localhost:5432/dictionary_db

# LLM Provider Configuration
# Required for generating dictionary definitions

# API Method: 'responses' or 'chat'
# 'responses' uses the newer OpenAI Responses API (default, recommended)
# 'chat' uses the Chat Completions API
# IMPORTANT: For proxy sites (like api.oaipro.com), use 'chat' method
LLM_METHOD=chat

# OpenAI Configuration (if using OpenAI)
LLM_API=https://api.openai.com/v1
LLM_KEY=sk-your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Proxy Site Example (using api.oaipro.com):
# LLM_API=https://api.oaipro.com/v1
# LLM_KEY=your_api_key_here
# LLM_METHOD=chat
# LLM_MODEL=gpt-4o-mini

# OR Anthropic Configuration (if using Anthropic)
# LLM_API=https://api.anthropic.com
# LLM_KEY=sk-ant-your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-sonnet-20241022

# OR other LLM providers...
# Set LLM_API, LLM_KEY, and LLM_MODEL according to your provider

# SQLite Output Path (for generated dictionary definitions)
# Defaults to data/dictionary.sqlite
SQLITE_PATH=data/dictionary.sqlite

# Worker Configuration (for parallel processing)
# Maximum number of parallel LLM requests
MAX_WORKERS=50

# Batch Size for database operations
BATCH_SIZE=50

# Development/Testing Settings
# Set to true for verbose logging
DEBUG=false

# Data Directory
# Where to store downloaded and extracted Wiktionary data
DATA_DIR=data
